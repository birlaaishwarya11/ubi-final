{
  "model_version": "v1",
  "model_file": "model_v1.onnx",
  "input_name": "input",
  "input_shape": [1, 4],
  "output_name": "variable",
  "output_kind": "classifier_softmax",
  "output_classes": [0, 1],
  "axes": [
    {
      "name": "SkinTemperature",
      "source": "sensor_windows.skin_temp_c",
      "unit": "°C"
    },
    {
      "name": "HeartRateVariability",
      "source": "sensor_windows.hrv_ms",
      "unit": "ms"
    },
    {
      "name": "ElectrodermalActivity",
      "source": "sensor_windows.eda_microsiemens",
      "unit": "µS"
    },
    {
      "name": "ImmuneActivationScore",
      "source": "PLACEHOLDER",
      "unit": "score 0-100",
      "placeholder_value": 47.21
    }
  ],
  "normalization": null,
  "score_mapping": {
    "immune_score": "softmax_prob_class_1 * 100",
    "risk_label": "argmax_class"
  }
}
